# Optional environment fallback for local development.
# For normal product use, configure Alpaca from the "My Profile" page instead.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Required only when downloading SEC EDGAR Company Facts. SEC asks automated
# clients to identify the application and a contact email.
SEC_USER_AGENT=Visual Quant Debugger contact@example.com

# Optional: provide a stable Fernet key for the encrypted local credential vault.
# Generate one locally and never commit its value.
VQD_SECRETS_MASTER_KEY=

# Public showcase: disable all mutating /api/* requests.
VQD_DEMO_MODE=false

# Enable Python file uploads for a trusted container/reverse-proxy deployment.
# Keep false on public or LAN-exposed servers; uploaded code executes with backend permissions.
VQD_TRUST_PYTHON_UPLOADS=false
